# Copy this file to .env and fill in real values for your environment.
PORT=5000
DATABASE_URL=

# Required - the server refuses to boot without this (see src/server.js). Used to sign/verify
# every login JWT (src/utils/jwt.js). Set this to any long random string in each environment;
# there is deliberately no insecure fallback default.
JWT_SECRET=

# Cloudinary (signed uploads - see README.md "Media Storage" for where to find these)
CLOUDINARY_CLOUD_NAME= 
CLOUDINARY_API_KEY= 
CLOUDINARY_API_SECRET= 
